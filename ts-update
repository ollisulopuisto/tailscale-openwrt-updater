#!/bin/sh
# ts-update — Semi-automated Tailscale updates on OpenWrt.
#
#   ts-update check             show current and latest version
#   ts-update run [--dry-run]   update, run health check, arm watchdog
#   ts-update confirm           confirm successful update (cancels rollback)
#   ts-update rollback          restore previous version immediately
#   ts-update status            show status and remaining confirmation time
#   ts-update boot-check        after boot: resume watchdog or rollback pending update
#
# Configuration via environment variables or /etc/default/ts-update
# (environment variables take precedence over config file):
#   ARCH=arm64        override automatic architecture detection
#   TIMEOUT=300       seconds for confirmation window before auto-rollback
#   PEER=100.74.52.79 optional tailnet IP/hostname to ping in health test
#   IFACE=tailscale0  network interface whose existence is checked
#   CHECK_ROUTES=1    verify advertised routes are preserved across update
#   HEALTH_WAIT=90    seconds to wait for daemon to start
#   WGET=wget         download command (expects wget-compatible -q/-T/-O flags)

set -u

usage() {
	cat <<'EOF'
ts-update — Semi-automated Tailscale updates on OpenWrt.

  ts-update check             show current and latest version
  ts-update run [--dry-run]   update, run health check, arm watchdog
  ts-update confirm           confirm successful update (cancels rollback)
  ts-update rollback          restore previous version immediately
  ts-update status            show status and remaining confirmation time
  ts-update boot-check        after boot: resume watchdog or rollback pending update

Configuration via environment variables or /etc/default/ts-update
(environment variables take precedence over config file):

  ARCH=arm64        override automatic architecture detection
  TIMEOUT=300       seconds for confirmation window before auto-rollback
  PEER=100.74.52.79 optional tailnet IP/hostname to ping in health test
  IFACE=tailscale0  network interface whose existence is checked
  CHECK_ROUTES=1    verify advertised routes are preserved across update
  HEALTH_WAIT=90    seconds to wait for daemon to start
  WGET=wget         download command (expects wget-compatible -q/-T/-O flags)
EOF
}

# --- settings: environment > /etc/default/ts-update > default -------------

CONFIG_FILE="${CONFIG_FILE:-/etc/default/ts-update}"

# All settings go through the same order: values from environment are captured
# before reading config file so the file cannot override a single-run env var.
SETTINGS="ARCH TIMEOUT PEER IFACE CHECK_ROUTES HEALTH_WAIT
	STATE_DIR BACKUP_DIR SBIN_DIR INIT_SCRIPT LOCK_FILE TMP_DIR
	BASE_URL WGET"

for _s in $SETTINGS; do
	eval "_env_$_s=\${$_s:-}"
done
unset _s

if [ -r "$CONFIG_FILE" ]; then
	# shellcheck disable=SC1090  # path chosen by user
	. "$CONFIG_FILE"
fi

# setting <name> <default>
setting() {
	eval "_e=\${_env_$1:-}; _f=\${$1:-}"
	if [ -n "$_e" ]; then
		eval "$1=\$_e"
	elif [ -n "$_f" ]; then
		eval "$1=\$_f"
	else
		eval "$1=\$2"
	fi
}

setting ARCH ''            # empty = auto-detect
setting TIMEOUT 300
setting PEER ''
setting IFACE tailscale0
setting CHECK_ROUTES 1
setting HEALTH_WAIT 90

# Persistent state in /root, not /tmp: must survive a reboot,
# otherwise unconfirmed updates would become permanent across reboots.
# Paths can be overridden; test suite (tests/run-tests.sh) uses this
# to run everything in a sandbox without touching the host device.
setting STATE_DIR /root/ts-update
setting BACKUP_DIR /root/ts-backup
setting SBIN_DIR /usr/sbin
setting INIT_SCRIPT /etc/init.d/tailscale
setting LOCK_FILE /var/lock/ts-update.lock
setting TMP_DIR /tmp
setting BASE_URL https://pkgs.tailscale.com/stable
# Download command. On OpenWrt wget is uclient-fetch; if device only has
# another fetcher, it can be passed here (expects wget flags -q/-T/-O).
setting WGET wget

DEADLINE_FILE="$STATE_DIR/deadline"
UPTIME_FILE="$STATE_DIR/deadline.uptime"
PENDING_FILE="$STATE_DIR/pending"
WATCHDOG_PID="$STATE_DIR/watchdog.pid"
EXPECT_ROUTES="$STATE_DIR/expect.routes"
EXPECT_IFACE="$STATE_DIR/expect.iface"
LOG="$STATE_DIR/ts-update.log"
LOCK_DIR_HELD=""
# Cache is run-specific ($$) and cleaned up at exit: persistent file
# in /tmp would show stale version list on subsequent runs.
JSON_CACHE="$TMP_DIR/ts-update.stable.$$.json"

# Lower bound for work directory space before download, in KiB. Measured:
# 1.102.2 mipsle tarball is 32.3 MiB, so download alone needs that much.
# Exact requirement calculated once tarball size is known; this is a rough filter
# to reject an obviously too-small /tmp immediately.
NEED_TMP_KIB=40960
LOG_MAX_BYTES=262144

mkdir -p "$STATE_DIR" 2>/dev/null || true
mkdir -p "$TMP_DIR" 2>/dev/null || true

have() { command -v "$1" >/dev/null 2>&1; }

# Console copy goes to stderr, not stdout: latest_version and
# tarball_list run inside $( ), and a log line on stdout would
# become part of their return value.
log() {
	_msg="$(date '+%F %T') $*"
	echo "$_msg" >&2
	if [ -d "$STATE_DIR" ]; then
		echo "$_msg" >> "$LOG" 2>/dev/null || true
		_sz="$(wc -c < "$LOG" 2>/dev/null || echo 0)"
		if [ "$_sz" -gt "$LOG_MAX_BYTES" ] 2>/dev/null; then
			tail -n 500 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
		fi
	fi
	logger -t ts-update "$*" 2>/dev/null || true
}

# --- architecture -------------------------------------------------------

# Detects Tailscale tarball architecture. OpenWrt's DISTRIB_ARCH is the
# most reliable source; uname -m returns just "mips" on little-endian MIPS,
# so in that case byte order is read from ELF header.
# Guess is verified against server's Tarballs list (see tarball_available),
# so an incorrect guess is caught before downloading.
detect_arch() {
	a=""
	if [ -r /etc/openwrt_release ]; then
		# shellcheck disable=SC1091  # device release file, not in repo
		a="$(. /etc/openwrt_release 2>/dev/null; echo "${DISTRIB_ARCH:-}")"
	fi
	[ -n "$a" ] || a="$(uname -m)"

	case "$a" in
		x86_64*|amd64*)      echo amd64 ;;
		aarch64*|arm64*)     echo arm64 ;;
		armv5*|armv6*|armv7*|arm_*|arm)  echo arm ;;
		mips64el*|mips64le*) echo mips64le ;;
		mips64*)             echo mips64 ;;
		mipsel*|mipsle*)     echo mipsle ;;
		mips*)
			# uname fallback: byte 6 in ELF header is 01 = little-endian
			if [ "$(od -An -t x1 -j 5 -N 1 /bin/busybox 2>/dev/null | tr -d ' ')" = "01" ]; then
				echo mipsle
			else
				echo mips
			fi
			;;
		riscv64*)            echo riscv64 ;;
		i[3456]86*|x86*)     echo 386 ;;
		*)                   echo "" ;;
	esac
}

[ -n "$ARCH" ] || ARCH="$(detect_arch)"

# --- locking ------------------------------------------------------------

# Prevents concurrent binary update operations. flock is in busybox;
# if missing, directory lock is used, cleaned up if lock-owning process is dead.
lock_acquire() {
	_wait="${1:-0}"
	mkdir -p "$(dirname "$LOCK_FILE")" 2>/dev/null || true

	if have flock; then
		# exec redirection failure would kill shell, so writeability
		# is checked first with normal redirection.
		: > "$LOCK_FILE" 2>/dev/null || return 1
		exec 9>"$LOCK_FILE"
		if [ "$_wait" -gt 0 ]; then
			flock -w "$_wait" 9 && return 0
		else
			flock -n 9 && return 0
		fi
		return 1
	fi

	_d="$LOCK_FILE.d"
	_end=$(( $(date +%s) + _wait ))
	while :; do
		if mkdir "$_d" 2>/dev/null; then
			echo $$ > "$_d/pid"
			LOCK_DIR_HELD="$_d"
			return 0
		fi
		_opid="$(cat "$_d/pid" 2>/dev/null)"
		if [ -z "$_opid" ] || ! kill -0 "$_opid" 2>/dev/null; then
			rm -rf "$_d"
			continue
		fi
		[ "$(date +%s)" -lt "$_end" ] || return 1
		sleep 1
	done
}

lock_release() {
	if [ -n "$LOCK_DIR_HELD" ]; then
		rm -rf "$LOCK_DIR_HELD"
		LOCK_DIR_HELD=""
	elif have flock; then
		exec 9>&-
	fi
}

cleanup() { lock_release; rm -f "$JSON_CACHE"; }

# INT/TERM must also exit: simple cleanup trap would leave execution running
# (Ctrl-C would release lock during binary swap, and disarm kill wouldn't kill watchdog).
trap 'cleanup' EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# --- disk space ---------------------------------------------------------

# df Available is 3rd field from end even when device name pushes line wide.
free_kib() { df -k "$1" 2>/dev/null | awk 'END { print $(NF-2) }'; }

file_kib() {
	_sum=0
	for _f in "$@"; do
		[ -f "$_f" ] || continue
		_n="$(wc -c < "$_f" 2>/dev/null || echo 0)"
		_sum=$(( _sum + (_n + 1023) / 1024 ))
	done
	echo "$_sum"
}

need_space() {  # need_space <path> <KiB> <description>
	_p="$1"; _need="$2"; _what="$3"
	_free="$(free_kib "$_p")"
	case "$_free" in
		''|*[!0-9]*)
			log "WARNING: $_p: free space could not be determined, proceeding"
			return 0 ;;
	esac
	if [ "$_free" -lt "$_need" ]; then
		log "ERROR: $_p: $_free KiB free, $_what requires $_need KiB"
		return 1
	fi
	return 0
}

# --- JSON ---------------------------------------------------------------

# jsonfilter (libubox) is standard on OpenWrt. sed fallback remains
# in case it is absent — more fragile but better than nothing.
fetch_stable_json() {
	[ -s "$JSON_CACHE" ] && return 0
	# Work directory in settings might point to uncreated disk path.
	# Without this, download fails silently without reason.
	if ! mkdir -p "$TMP_DIR" 2>/dev/null || [ ! -w "$TMP_DIR" ]; then
		log "ERROR: cannot write to working directory: $TMP_DIR"
		return 1
	fi
	if ! "$WGET" -q -T 30 -O "$JSON_CACHE" "$BASE_URL/?mode=json" 2>/dev/null; then
		rm -f "$JSON_CACHE"
		return 1
	fi
	[ -s "$JSON_CACHE" ] || { rm -f "$JSON_CACHE"; return 1; }
	return 0
}

# json_string <file> <jsonfilter-expression> <sed-fallback-key-name>
json_string() {
	_f="$1"; _expr="$2"; _key="$3"
	if have jsonfilter; then
		_v="$(jsonfilter -i "$_f" -e "$_expr" 2>/dev/null)"
		if [ -n "$_v" ]; then
			printf '%s\n' "$_v"
			return 0
		fi
	fi
	tr '\n' ' ' < "$_f" \
		| sed -n "s/.*\"$_key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
		| head -n1
}

latest_version() {
	fetch_stable_json || return 1
	json_string "$JSON_CACHE" '@.TarballsVersion' TarballsVersion
}

# Server tarballs, e.g., tailscale_1.102.2_arm64.tgz.
tarball_list() {
	fetch_stable_json || return 1
	if have jsonfilter; then
		_l="$(jsonfilter -i "$JSON_CACHE" -e '@.Tarballs[*]' 2>/dev/null)"
		if [ -n "$_l" ]; then
			printf '%s\n' "$_l"
			return 0
		fi
	fi
	# shellcheck disable=SC2020  # intentional character replace for newline
	tr ',{}' '\n\n\n' < "$JSON_CACHE" \
		| sed -n 's/.*"\(tailscale_[^"]*\.tgz\)".*/\1/p'
}

available_arches() {
	tarball_list | sed -n 's/^tailscale_[^_]*_\(.*\)\.tgz$/\1/p' | sort | tr '\n' ' '
}

# 0 = version/architecture exists on server.
tarball_available() {  # tarball_available <version> <arch>
	tarball_list | grep -qxF "tailscale_$1_$2.tgz"
}

# --- versions -----------------------------------------------------------

# OpenWrt package reports "1.98.3-1 (OpenWrt)" but upstream
# TarballsVersion is "1.98.3". Comparison is done on numeric part only,
# so feed version doesn't permanently look like a different version than upstream.
normalize_version() {
	printf '%s\n' "${1:-}" | awk '{print $1}' | sed 's/^v//; s/[-_].*$//'
}

current_version() { tailscale version 2>/dev/null | head -n1; }

# 0 = $1 is genuinely newer than $2
version_newer() {
	_a="$(normalize_version "$1")"
	_b="$(normalize_version "$2")"
	[ -n "$_a" ] && [ -n "$_b" ] || return 0
	[ "$_a" = "$_b" ] && return 1
	_first="$(printf '%s\n%s\n' "$_a" "$_b" | sort -t. -k1,1n -k2,2n -k3,3n | head -n1)"
	[ "$_first" = "$_b" ]
}

# --- health check -------------------------------------------------------

backend_state() {
	if have jsonfilter; then
		_s="$(tailscale status --json 2>/dev/null | jsonfilter -e '@.BackendState' 2>/dev/null)"
		if [ -n "$_s" ]; then
			printf '%s\n' "$_s"
			return 0
		fi
	fi
	tailscale status --json 2>/dev/null | tr '\n' ' ' \
		| sed -n 's/.*"BackendState"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
		| head -n1
}

prefs_routes() {
	if have jsonfilter; then
		_r="$(tailscale debug prefs 2>/dev/null | jsonfilter -e '@.AdvertiseRoutes[*]' 2>/dev/null)"
		if [ -n "$_r" ]; then
			printf '%s\n' "$_r" | sort
			return 0
		fi
	fi
	tailscale debug prefs 2>/dev/null | tr -d ' \n' \
		| sed -n 's/.*"AdvertiseRoutes":\[\([^]]*\)\].*/\1/p' \
		| tr ',' '\n' | tr -d '"' | sed '/^$/d' | sort
}

iface_exists() { [ -e "/sys/class/net/$IFACE" ]; }

# Save state prior to update: "Running" alone is not enough for subnet router
# or exit node if advertised routes disappear from prefs.
snapshot_health() {
	if iface_exists; then echo 1 > "$EXPECT_IFACE"; else echo 0 > "$EXPECT_IFACE"; fi
	prefs_routes > "$EXPECT_ROUTES" 2>/dev/null || : > "$EXPECT_ROUTES"
}

routes_ok() {
	[ "$CHECK_ROUTES" = "1" ] || return 0
	[ -s "$EXPECT_ROUTES" ] || return 0
	# No diff: not included in OpenWrt busybox default applets.
	[ "$(prefs_routes)" = "$(cat "$EXPECT_ROUTES" 2>/dev/null)" ]
}

iface_ok() {
	[ -f "$EXPECT_IFACE" ] || return 0
	[ "$(cat "$EXPECT_IFACE" 2>/dev/null)" = "1" ] || return 0
	iface_exists
}

peer_ok() {
	[ -n "$PEER" ] || return 0
	tailscale ping -c 1 --timeout 5s "$PEER" >/dev/null 2>&1
}

# Waits for daemon to start and all checks to pass.
# 0 = healthy.
health_check() {
	_i=0
	_why="daemon failed to start"
	while [ "$_i" -lt "$HEALTH_WAIT" ]; do
		if [ "$(backend_state)" = "Running" ]; then
			_why=""
			iface_ok  || _why="network interface $IFACE missing"
			if [ -z "$_why" ]; then
				routes_ok || _why="advertised routes do not match pre-update state"
			fi
			if [ -z "$_why" ]; then
				peer_ok || _why="peer $PEER failed to respond"
			fi
			[ -z "$_why" ] && return 0
		fi
		sleep 3
		_i=$(( _i + 3 ))
	done
	log "health check: $_why"
	return 1
}

# --- binaries -----------------------------------------------------------

# In feed installation, tailscale is a symlink to tailscaled. Symlink is not
# gzipped: that would store the same ~30 MB binary twice and double
# both backup and required disk space.
backup_binaries() {
	mkdir -p "$BACKUP_DIR" || return 1

	_link=""
	[ -L "$SBIN_DIR/tailscale" ] && _link="$(readlink "$SBIN_DIR/tailscale")"

	if [ -n "$_link" ]; then
		_raw="$(file_kib "$SBIN_DIR/tailscaled")"
	else
		_raw="$(file_kib "$SBIN_DIR/tailscaled" "$SBIN_DIR/tailscale")"
	fi
	# Go binaries compress to ~40%; 60% is a conservative estimate.
	# Final protection is gzip's own error before anything is changed.
	need_space "$BACKUP_DIR" "$(( _raw * 3 / 5 ))" "backup" || return 1

	gzip -c "$SBIN_DIR/tailscaled" > "$BACKUP_DIR/tailscaled.gz.new" || return 1
	mv "$BACKUP_DIR/tailscaled.gz.new" "$BACKUP_DIR/tailscaled.gz" || return 1

	rm -f "$BACKUP_DIR/tailscale.link"
	if [ -n "$_link" ]; then
		printf '%s\n' "$_link" > "$BACKUP_DIR/tailscale.link"
		rm -f "$BACKUP_DIR/tailscale.gz"
	else
		gzip -c "$SBIN_DIR/tailscale" > "$BACKUP_DIR/tailscale.gz.new" || return 1
		mv "$BACKUP_DIR/tailscale.gz.new" "$BACKUP_DIR/tailscale.gz" || return 1
	fi

	current_version > "$BACKUP_DIR/version"
	sync
	return 0
}

# Rough estimate of new binary size in target location. Upstream tarball has
# two separate binaries whereas feed install has one binary + symlink, and upstream
# binaries are larger than OpenWrt size-optimized build: measured 1.102.2
# mipsle = tailscaled 38.7 MiB + tailscale 31.7 MiB = 70.4 MiB, while feed
# combined binary is 29.1 MiB. Double current size is still an underestimate,
# but enough to reject small flash devices before downloading; exact check is
# done in install_from on actual unpacked sizes.
install_floor_kib() { echo "$(( $(file_kib "$SBIN_DIR/tailscaled") * 2 ))"; }

# Checks unpacked binaries exist and can execute on this device.
# Done before stopping service: wrong architecture won't drop connection.
verify_binaries() {
	_d="$1"
	if [ ! -f "$_d/tailscaled" ] || [ ! -f "$_d/tailscale" ]; then
		log "ERROR: extracted package does not contain both binaries"
		return 1
	fi
	chmod 755 "$_d/tailscaled" "$_d/tailscale" || return 1
	_v="$("$_d/tailscale" version 2>/dev/null | head -n1)"
	if [ -z "$_v" ]; then
		log "ERROR: new tailscale binary does not run on this device (wrong architecture?)"
		return 1
	fi
	log "new binary executable: $_v"
	return 0
}

# Feed package installs /usr/sbin/tailscale as a symlink to tailscaled;
# in upstream tarball they are two separate files, so symlink is replaced
# via mv with actual binary.
install_from() {
	_dir="$1"
	_need="$(file_kib "$_dir/tailscaled" "$_dir/tailscale")"
	need_space "$SBIN_DIR" "$_need" "binary replacement" || return 1
	"$INIT_SCRIPT" stop
	sleep 1
	cp "$_dir/tailscaled" "$SBIN_DIR/tailscaled.new" || return 1
	cp "$_dir/tailscale"  "$SBIN_DIR/tailscale.new"  || return 1
	chmod 755 "$SBIN_DIR/tailscaled.new" "$SBIN_DIR/tailscale.new"
	mv "$SBIN_DIR/tailscaled.new" "$SBIN_DIR/tailscaled" || return 1
	mv "$SBIN_DIR/tailscale.new"  "$SBIN_DIR/tailscale"  || return 1
	sync
	"$INIT_SCRIPT" start
	return 0
}

do_rollback() {
	if [ ! -f "$BACKUP_DIR/tailscaled.gz" ]; then
		log "ERROR: no backup found, rollback impossible"
		return 1
	fi
	if [ ! -f "$BACKUP_DIR/tailscale.gz" ] && [ ! -f "$BACKUP_DIR/tailscale.link" ]; then
		log "ERROR: backup incomplete, rollback impossible"
		return 1
	fi
	_old="$(cat "$BACKUP_DIR/version" 2>/dev/null)"
	log "restoring version: $_old"
	"$INIT_SCRIPT" stop
	sleep 1
	gunzip -c "$BACKUP_DIR/tailscaled.gz" > "$SBIN_DIR/tailscaled.new" || return 1
	chmod 755 "$SBIN_DIR/tailscaled.new"
	rm -f "$SBIN_DIR/tailscale.new"
	if [ -f "$BACKUP_DIR/tailscale.link" ]; then
		# restore feed symlink layout as-is
		ln -s "$(cat "$BACKUP_DIR/tailscale.link")" "$SBIN_DIR/tailscale.new" || return 1
	else
		gunzip -c "$BACKUP_DIR/tailscale.gz" > "$SBIN_DIR/tailscale.new" || return 1
		chmod 755 "$SBIN_DIR/tailscale.new"
	fi
	mv "$SBIN_DIR/tailscaled.new" "$SBIN_DIR/tailscaled" || return 1
	mv "$SBIN_DIR/tailscale.new"  "$SBIN_DIR/tailscale"  || return 1
	sync
	"$INIT_SCRIPT" start
	sleep 5
	log "rollback complete, now: $(current_version)"
	return 0
}

# --- watchdog -----------------------------------------------------------

# Pending update is active even if watchdog wasn't armed yet:
# PENDING_FILE is written before binary swap, DEADLINE_FILE only after health check.
pending_active() { [ -f "$DEADLINE_FILE" ] || [ -f "$PENDING_FILE" ]; }

# PID file remains on disk over boot, but process does not. Simple kill -0
# might hit a recycled PID, so verify in /proc that it's this script.
watchdog_alive() {
	[ -f "$WATCHDOG_PID" ] || return 1
	_wp="$(cat "$WATCHDOG_PID" 2>/dev/null)"
	case "$_wp" in
		''|*[!0-9]*) return 1 ;;
	esac
	kill -0 "$_wp" 2>/dev/null || return 1
	if [ -r "/proc/$_wp/cmdline" ]; then
		tr '\0' ' ' < "/proc/$_wp/cmdline" 2>/dev/null | grep -q ts-update
	elif _ps_out="$(ps -p "$_wp" -o args= 2>/dev/null)" && [ -n "$_ps_out" ]; then
		echo "$_ps_out" | grep -Eq "ts-update|sh|bash|zsh"
	else
		return 0
	fi
}

disarm() {
	if watchdog_alive; then
		kill "$(cat "$WATCHDOG_PID" 2>/dev/null)" 2>/dev/null
	fi
	rm -f "$WATCHDOG_PID" "$DEADLINE_FILE" "$UPTIME_FILE" "$PENDING_FILE"
	sync
}

# Watchdog is detached from session so it survives SSH disconnect.
# 9>&- closes inherited lock handle: otherwise child holds lock full confirmation window.
# log() writes to log file directly, so only unexpected stderr is redirected.
spawn_watchdog() {
	_secs="$1"
	if have setsid; then
		TIMEOUT="$_secs" ARCH="$ARCH" PEER="$PEER" IFACE="$IFACE" \
		CHECK_ROUTES="$CHECK_ROUTES" HEALTH_WAIT="$HEALTH_WAIT" \
			setsid "$0" _watchdog >/dev/null 2>>"$LOG.stderr" < /dev/null 9>&- &
	else
		TIMEOUT="$_secs" ARCH="$ARCH" PEER="$PEER" IFACE="$IFACE" \
		CHECK_ROUTES="$CHECK_ROUTES" HEALTH_WAIT="$HEALTH_WAIT" \
			nohup "$0" _watchdog >/dev/null 2>>"$LOG.stderr" < /dev/null 9>&- &
	fi
	echo $! > "$WATCHDOG_PID"
	sync
}

# Seconds since boot. Monotonic: NTP jumps will not shift this.
uptime_now() {
	if [ -r /proc/uptime ]; then
		awk '{print int($1); exit}' /proc/uptime 2>/dev/null
	elif command -v sysctl >/dev/null 2>&1; then
		_b="$(sysctl -n kern.boottime 2>/dev/null | awk -F'[=,]' '{print $2}' | tr -d ' ')"
		case "$_b" in
			''|*[!0-9]*) return 1 ;;
		esac
		_now="$(date +%s)"
		echo "$(( _now - _b ))"
	elif [ -x /usr/sbin/sysctl ]; then
		_b="$(/usr/sbin/sysctl -n kern.boottime 2>/dev/null | awk -F'[=,]' '{print $2}' | tr -d ' ')"
		case "$_b" in
			''|*[!0-9]*) return 1 ;;
		esac
		_now="$(date +%s)"
		echo "$(( _now - _b ))"
	else
		return 1
	fi
}

# Deadline recorded twice: monotonic post-boot time and wall-clock timestamp.
# First survives clock jumps, second survives reboots.
write_deadlines() {
	_secs="$1"
	echo "$(( $(date +%s) + _secs ))" > "$DEADLINE_FILE"
	rm -f "$UPTIME_FILE"
	if _up="$(uptime_now)"; then
		echo "$(( _up + _secs ))" > "$UPTIME_FILE"
	fi
	sync
}

arm_watchdog() {
	_secs="${1:-$TIMEOUT}"
	write_deadlines "$_secs"
	spawn_watchdog "$_secs"
}

# Without monotonic counter, a 1-hour NTP forward jump would end
# confirmation window immediately and rollback working update.
# Observed on real hardware without RTC.
deadline_left() {
	if _up="$(uptime_now)" && [ -f "$UPTIME_FILE" ]; then
		_ud="$(cat "$UPTIME_FILE" 2>/dev/null)"
		case "$_ud" in
			''|*[!0-9]*) _ud="" ;;
		esac
		if [ -n "$_ud" ]; then
			_left=$(( _ud - _up ))
			# Left cannot exceed full window. If it does, file is from
			# previous boot and uptime reset.
			if [ "$_left" -le "$TIMEOUT" ]; then
				echo "$_left"
				return 0
			fi
		fi
	fi
	_dl="$(cat "$DEADLINE_FILE" 2>/dev/null)"
	case "$_dl" in
		''|*[!0-9]*) echo 0; return 1 ;;
	esac
	echo $(( _dl - $(date +%s) ))
}

# --- commands -----------------------------------------------------------

cmd_check() {
	echo "architecture: ${ARCH:-UNKNOWN}"
	echo "current:      $(current_version)"
	_new="$(latest_version)"
	if [ -n "$_new" ]; then
		echo "latest:       $_new"
	else
		echo "latest:       FAILED TO FETCH — network or $TMP_DIR? see $LOG"
	fi
	if [ -n "$_new" ] && [ -n "$ARCH" ]; then
		if tarball_available "$_new" "$ARCH"; then
			echo "package:      tailscale_${_new}_${ARCH}.tgz"
		else
			echo "package:      NOT FOUND on server"
			echo "available:    $(available_arches)"
		fi
	fi
	if [ -n "$_new" ] && ! version_newer "$_new" "$(current_version)"; then
		echo "status:       up to date"
	fi
	_floor="$(install_floor_kib)"
	_free="$(free_kib "$SBIN_DIR")"
	case "$_free" in
		''|*[!0-9]*) ;;
		*)
			echo "disk space:   $SBIN_DIR free $(( _free / 1024 )) MB, need at least $(( _floor / 1024 )) MB"
			if [ "$_free" -lt "$_floor" ]; then
				echo "               INSUFFICIENT — see README, small flash devices"
			fi
			;;
	esac
}

cmd_run() {
	_dry=0
	case "${1:-}" in
		--dry-run|-n) _dry=1 ;;
		'') ;;
		*) echo "unknown option: $1"; exit 1 ;;
	esac

	if ! lock_acquire 0; then
		echo "Another ts-update instance is currently running."
		exit 1
	fi

	if [ -z "$ARCH" ]; then
		log "ERROR: architecture could not be detected, specify manually: ARCH=... $0 run"
		exit 1
	fi
	if pending_active; then
		echo "Previous update is still pending confirmation. Run first: $0 confirm"
		exit 1
	fi

	cur="$(current_version)"
	new="$(latest_version)"
	if [ -z "$new" ]; then
		log "ERROR: could not determine latest version"
		exit 1
	fi
	if ! version_newer "$new" "$cur"; then
		echo "Already on latest: $cur (upstream: $new)"
		exit 0
	fi
	if ! tarball_available "$new" "$ARCH"; then
		log "ERROR: server does not have package tailscale_${new}_${ARCH}.tgz"
		log "available architectures: $(available_arches)"
		log "set correct architecture manually: ARCH=... $0 run"
		exit 1
	fi

	if [ "$_dry" = 1 ]; then
		log "DRY RUN: $cur -> $new ($ARCH), binaries will not be changed"
	else
		log "updating $cur -> $new ($ARCH)"
	fi

	tgz="$TMP_DIR/tailscale_${new}_${ARCH}.tgz"
	dir="$TMP_DIR/tailscale_${new}_${ARCH}"
	sha="$TMP_DIR/ts-update.sha"
	rm -rf "$tgz" "$dir" "$sha"

	# Target path space check first: if binaries won't fit, download is useless.
	# On small flash devices this stops run in seconds.
	need_space "$SBIN_DIR" "$(install_floor_kib)" "binary replacement" || {
		log "no space in target location for new binaries — aborting download"
		exit 1
	}
	need_space "$TMP_DIR" "$NEED_TMP_KIB" "download" || exit 1

	"$WGET" -q -T 60 "$BASE_URL/tailscale_${new}_${ARCH}.tgz" -O "$tgz" || {
		log "ERROR: download failed"; rm -f "$tgz"; exit 1; }
	"$WGET" -q -T 60 "$BASE_URL/tailscale_${new}_${ARCH}.tgz.sha256" -O "$sha" || {
		log "ERROR: failed to get checksum"; rm -f "$tgz" "$sha"; exit 1; }

	sum="$(awk 'NF {print $1; exit}' "$sha")"
	if [ -z "$sum" ]; then
		log "ERROR: checksum is empty"
		rm -f "$tgz" "$sha"
		exit 1
	fi
	if ! (cd "$TMP_DIR" && echo "$sum  $(basename "$tgz")" | sha256sum -c - >/dev/null 2>&1 || (cd "$TMP_DIR" && echo "$sum  $(basename "$tgz")" | sha256sum -c >/dev/null 2>&1)); then
		log "ERROR: checksum mismatch"
		rm -f "$tgz" "$sha"
		exit 1
	fi
	log "checksum ok"

	# Tarball size now known. Measured ratio (1.102.2 mipsle): 32.3
	# MiB compressed, 70.4 MiB unpacked, tarball stays on disk during extraction
	# — total 3.2x. 3.5x gives safe margin.
	need_space "$TMP_DIR" "$(( $(file_kib "$tgz") * 7 / 2 ))" "extraction" || {
		rm -f "$tgz" "$sha"
		exit 1
	}

	tar xzf "$tgz" -C "$TMP_DIR" || {
		log "ERROR: extraction failed"; rm -rf "$tgz" "$sha" "$dir"; exit 1; }

	verify_binaries "$dir" || { rm -rf "$tgz" "$sha" "$dir"; exit 1; }

	if [ "$_dry" = 1 ]; then
		rm -rf "$dir" "$tgz" "$sha"
		cat <<EOF

  Dry run complete: $cur -> $new ($ARCH)
  Download, checksum, and binary execution check ok.
  Nothing was stopped or modified. To perform actual update: $0 run

EOF
		exit 0
	fi

	snapshot_health

	backup_binaries || { log "ERROR: backup failed, aborting"; exit 1; }
	log "backup: $BACKUP_DIR ($cur)"

	printf '%s\n' "$cur -> $new ($ARCH)" > "$PENDING_FILE"

	install_from "$dir" || {
		log "ERROR: installation failed, rolling back"
		do_rollback
		rm -f "$PENDING_FILE"
		exit 1
	}

	rm -rf "$dir" "$tgz" "$sha"

	if ! health_check; then
		log "health check failed — rolling back immediately"
		do_rollback
		rm -f "$PENDING_FILE"
		exit 1
	fi

	log "installed and daemon running: $(current_version)"
	arm_watchdog "$TIMEOUT"

	cat <<EOF

  Update complete: $cur -> $new
  Rollback will trigger automatically in $(( TIMEOUT / 60 )) min $(( TIMEOUT % 60 )) s unless you run:

      ts-update confirm

  Test connection FROM THE OUTSIDE (another tailnet device) before confirming.

EOF
}

cmd_confirm() {
	if ! pending_active; then
		echo "Nothing is pending confirmation."
		exit 0
	fi
	# Lock is held by watchdog during rollback: wait to avoid reporting
	# confirmation success in middle of rollback.
	if ! lock_acquire 60; then
		log "ERROR: failed to acquire lock — rollback may be in progress"
		exit 1
	fi
	if ! pending_active; then
		log "rollback occurred before confirmation, now: $(current_version)"
		exit 1
	fi
	disarm
	log "confirmed, rollback cancelled: $(current_version)"
}

cmd_rollback() {
	if ! lock_acquire 60; then
		log "ERROR: failed to acquire lock, another process is running"
		exit 1
	fi
	disarm
	do_rollback
}

cmd_status() {
	echo "architecture: ${ARCH:-UNKNOWN}"
	echo "version:      $(current_version)"
	echo "backup:       $(cat "$BACKUP_DIR/version" 2>/dev/null || echo 'none')"
	if pending_active; then
		echo "pending:      $(cat "$PENDING_FILE" 2>/dev/null || echo 'update')"
		if [ ! -f "$DEADLINE_FILE" ]; then
			echo "INCOMPLETE: update left without watchdog — run $0 boot-check or $0 rollback"
		else
			_left="$(deadline_left)"
			if [ "$_left" -gt 0 ]; then
				echo "PENDING CONFIRMATION: rollback in ${_left} s"
			else
				echo "PENDING CONFIRMATION: confirmation window expired"
			fi
			if watchdog_alive; then
				echo "watchdog:     running (pid $(cat "$WATCHDOG_PID"))"
			else
				echo "watchdog:     NOT RUNNING — run $0 boot-check or $0 rollback"
			fi
		fi
	else
		echo "no pending update"
	fi
	tailscale status 2>/dev/null | head -2
}

# Watchdog monitors deadline file, not plain sleep: confirm
# removes file causing watchdog to exit gracefully.
cmd_watchdog() {
	while :; do
		pending_active || exit 0
		_left="$(deadline_left)" || exit 0
		[ "$_left" -le 0 ] && break
		if [ "$_left" -gt 5 ]; then sleep 5; else sleep "$_left"; fi
	done
	log "no confirmation received within deadline — automatic rollback"
	if ! lock_acquire 120; then
		log "WARNING: lock not acquired within 120s, performing rollback anyway"
	fi
	# Confirmation could have arrived while waiting for lock.
	if ! pending_active; then
		log "confirmation arrived while waiting for lock — keeping new version"
		exit 0
	fi
	do_rollback
	rm -f "$WATCHDOG_PID" "$DEADLINE_FILE" "$UPTIME_FILE" "$PENDING_FILE"
	sync
}

# Executed after boot (/etc/init.d/ts-update-bootcheck). Without this,
# RAM-resident watchdog would die on reboot and unconfirmed update remain permanent.
cmd_boot_check() {
	pending_active || exit 0
	if ! lock_acquire 120; then
		log "boot-check: lock not acquired, skipping"
		exit 1
	fi
	# Pending update without deadline: reboot hit between binary swap and watchdog arming,
	# before new version was verified healthy. Unconfirmed version will not stay active.
	if [ ! -f "$DEADLINE_FILE" ]; then
		log "boot-check: update interrupted before watchdog setup — rolling back"
		disarm
		do_rollback
		exit 0
	fi

	_left="$(deadline_left)"
	# Clock may jump during NTP sync; deadline must not exceed original timeout window.
	if [ "$_left" -gt "$TIMEOUT" ]; then
		_left="$TIMEOUT"
	fi
	log "boot-check: unconfirmed update in progress ($(cat "$PENDING_FILE" 2>/dev/null))"

	if ! health_check; then
		log "boot-check: health check failed — rolling back"
		disarm
		do_rollback
		exit 0
	fi
	if [ "$_left" -le 0 ]; then
		log "boot-check: confirmation window expired — rolling back"
		disarm
		do_rollback
		exit 0
	fi
	log "boot-check: re-arming watchdog for ${_left} s"
	# Uptime reset on reboot, re-write both deadlines based on remaining time.
	write_deadlines "$_left"
	spawn_watchdog "$_left"
}

case "${1:-}" in
	check)      cmd_check ;;
	run)        shift; cmd_run "${1:-}" ;;
	confirm)    cmd_confirm ;;
	rollback)   cmd_rollback ;;
	status)     cmd_status ;;
	boot-check) cmd_boot_check ;;
	_watchdog)  cmd_watchdog ;;
	*)
		usage
		exit 1
		;;
esac


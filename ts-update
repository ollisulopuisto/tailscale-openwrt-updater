#!/bin/sh
# ts-update — Tailscalen puoliautomaattinen päivitys OpenWrt:llä.
#
#   ts-update check             näytä nykyinen ja uusin versio
#   ts-update run [--dry-run]   päivitä, terveystarkistus, viritä vahti
#   ts-update confirm           vahvista onnistunut päivitys (peruu rollbackin)
#   ts-update rollback          palauta edellinen versio heti
#   ts-update status            näytä tila ja jäljellä oleva vahvistusaika
#   ts-update boot-check        boottauksen jälkeen: jatka tai peru odottava päivitys
#
# Asetukset ympäristömuuttujina tai tiedostossa /etc/default/ts-update
# (ympäristö voittaa tiedoston):
#   ARCH=arm64        ohita arkkitehtuurin automaattitunnistus
#   TIMEOUT=300       sekuntia vahvistusaikaa ennen automaattista rollbackia
#   PEER=100.74.52.79 valinnainen tailnet-osoite, johon pingataan terveystestissä
#   IFACE=tailscale0  verkkoliitäntä, jonka olemassaolo tarkistetaan
#   CHECK_ROUTES=1    varmista että mainostetut reitit säilyvät päivityksessä
#   HEALTH_WAIT=90    sekuntia, joita odotetaan daemonin nousemista
#   WGET=wget         latauskomento (odottaa wgetin -q/-T/-O-valitsimia)

set -u

usage() {
	cat <<'EOF'
ts-update — Tailscalen puoliautomaattinen päivitys OpenWrt:llä.

  ts-update check             näytä nykyinen ja uusin versio
  ts-update run [--dry-run]   päivitä, terveystarkistus, viritä vahti
  ts-update confirm           vahvista onnistunut päivitys (peruu rollbackin)
  ts-update rollback          palauta edellinen versio heti
  ts-update status            näytä tila ja jäljellä oleva vahvistusaika
  ts-update boot-check        boottauksen jälkeen: jatka tai peru odottava päivitys

Asetukset ympäristömuuttujina tai tiedostossa /etc/default/ts-update
(ympäristö voittaa tiedoston):

  ARCH=arm64        ohita arkkitehtuurin automaattitunnistus
  TIMEOUT=300       sekuntia vahvistusaikaa ennen automaattista rollbackia
  PEER=100.74.52.79 valinnainen tailnet-osoite, johon pingataan terveystestissä
  IFACE=tailscale0  verkkoliitäntä, jonka olemassaolo tarkistetaan
  CHECK_ROUTES=1    varmista että mainostetut reitit säilyvät päivityksessä
  HEALTH_WAIT=90    sekuntia, joita odotetaan daemonin nousemista
  WGET=wget         latauskomento (odottaa wgetin -q/-T/-O-valitsimia)
EOF
}

# --- asetukset: ympäristö > /etc/default/ts-update > oletus -------------

CONFIG_FILE="${CONFIG_FILE:-/etc/default/ts-update}"

# Kaikki asetukset kulkevat saman järjestyksen läpi: ympäristöstä tullut
# arvo otetaan talteen ennen asetustiedoston lukemista, jotta tiedosto ei
# voi ohittaa yhden ajon ympäristömuuttujaa.
SETTINGS="ARCH TIMEOUT PEER IFACE CHECK_ROUTES HEALTH_WAIT
	STATE_DIR BACKUP_DIR SBIN_DIR INIT_SCRIPT LOCK_FILE TMP_DIR
	BASE_URL WGET"

for _s in $SETTINGS; do
	eval "_env_$_s=\${$_s:-}"
done
unset _s

if [ -r "$CONFIG_FILE" ]; then
	# shellcheck disable=SC1090  # polku on käyttäjän valitsema
	. "$CONFIG_FILE"
fi

# setting <nimi> <oletus>
setting() {
	eval "_e=\${_env_$1:-}; _f=\${$1:-}"
	if [ -n "$_e" ]; then
		eval "$1=\$_e"
	elif [ -n "$_f" ]; then
		eval "$1=\$_f"
	else
		eval "$1=\$2"
	fi
}

setting ARCH ''            # tyhjä = tunnistetaan automaattisesti
setting TIMEOUT 300
setting PEER ''
setting IFACE tailscale0
setting CHECK_ROUTES 1
setting HEALTH_WAIT 90

# Pysyvä tila /root:issa, ei /tmp:ssä: sen on selvittävä boottauksesta,
# muuten vahvistamaton päivitys jää voimaan uudelleenkäynnistyksessä.
# Polut voi ohittaa; testipeti (tests/run-tests.sh) käyttää tätä
# ajaakseen koko koneiston oikeaa laitetta koskematta.
setting STATE_DIR /root/ts-update
setting BACKUP_DIR /root/ts-backup
setting SBIN_DIR /usr/sbin
setting INIT_SCRIPT /etc/init.d/tailscale
setting LOCK_FILE /var/lock/ts-update.lock
setting TMP_DIR /tmp
setting BASE_URL https://pkgs.tailscale.com/stable
# Latauskomento. OpenWrt:llä wget on uclient-fetch; jos laitteella on
# vain jokin muu hakija, sen voi antaa tässä (odottaa wgetin -q/-T/-O).
setting WGET wget

DEADLINE_FILE="$STATE_DIR/deadline"
UPTIME_FILE="$STATE_DIR/deadline.uptime"
PENDING_FILE="$STATE_DIR/pending"
WATCHDOG_PID="$STATE_DIR/watchdog.pid"
EXPECT_ROUTES="$STATE_DIR/expect.routes"
EXPECT_IFACE="$STATE_DIR/expect.iface"
LOG="$STATE_DIR/ts-update.log"
LOCK_DIR_HELD=""
# Välimuisti on ajokohtainen ($$) ja siivotaan lopuksi: pysyvä tiedosto
# /tmp:ssä näyttäisi vanhaa versiolistaa seuraavallakin ajolla.
JSON_CACHE="$TMP_DIR/ts-update.stable.$$.json"

# Alaraja työtilalle ennen latausta, kilotavuina. Mitattu: 1.102.2 mipsle
# -tarballi on 32.3 MiB, joten pelkkä lataus vaatii sen verran. Tarkka
# vaatimus lasketaan vasta kun tarballin koko tiedetään; tämä on vain
# karkea seula, joka torjuu tyystin liian pienen /tmp:n heti.
NEED_TMP_KIB=40960
LOG_MAX_BYTES=262144

mkdir -p "$STATE_DIR" 2>/dev/null || true
mkdir -p "$TMP_DIR" 2>/dev/null || true

have() { command -v "$1" >/dev/null 2>&1; }

# Konsolikopio menee stderriin, ei stdoutiin: latest_version ja
# tarball_list ajetaan $( ):n sisällä, ja stdoutiin kirjoitettu
# lokirivi päätyisi niiden paluuarvoksi.
log() {
	_msg="$(date '+%F %T') $*"
	echo "$_msg" >&2
	if [ -d "$STATE_DIR" ]; then
		echo "$_msg" >> "$LOG" 2>/dev/null || true
		_sz="$(wc -c < "$LOG" 2>/dev/null || echo 0)"
		if [ "$_sz" -gt "$LOG_MAX_BYTES" ] 2>/dev/null; then
			tail -n 500 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
		fi
	fi
	logger -t ts-update "$*" 2>/dev/null || true
}

# --- arkkitehtuuri ------------------------------------------------------

# Päättelee Tailscalen tarball-arkkitehtuurin. OpenWrt:n DISTRIB_ARCH on
# luotettavin lähde; uname -m sanoo little-endian-MIPSillä pelkkä "mips",
# joten siinä tapauksessa tavujärjestys luetaan ELF-otsakkeesta.
# Arvaus tarkistetaan vielä palvelimen Tarballs-listaa vasten (ks.
# tarball_available), joten väärä arvaus huomataan ennen latausta.
detect_arch() {
	a=""
	if [ -r /etc/openwrt_release ]; then
		# shellcheck disable=SC1091  # laitteen oma tiedosto, ei repossa
		a="$(. /etc/openwrt_release 2>/dev/null; echo "${DISTRIB_ARCH:-}")"
	fi
	[ -n "$a" ] || a="$(uname -m)"

	case "$a" in
		x86_64*|amd64*)      echo amd64 ;;
		aarch64*|arm64*)     echo arm64 ;;
		armv5*|armv6*|armv7*|arm_*|arm)  echo arm ;;
		mips64el*|mips64le*) echo mips64le ;;
		mips64*)             echo mips64 ;;
		mipsel*|mipsle*)     echo mipsle ;;
		mips*)
			# uname-fallback: 6. tavu ELF-otsakkeessa on 01 = little-endian
			if [ "$(od -An -t x1 -j 5 -N 1 /bin/busybox 2>/dev/null | tr -d ' ')" = "01" ]; then
				echo mipsle
			else
				echo mips
			fi
			;;
		riscv64*)            echo riscv64 ;;
		i[3456]86*|x86*)     echo 386 ;;
		*)                   echo "" ;;
	esac
}

[ -n "$ARCH" ] || ARCH="$(detect_arch)"

# --- lukitus ------------------------------------------------------------

# Estää kaksi päällekkäistä binäärinvaihtoa. flock löytyy busyboxista;
# jos ei löydy, käytetään hakemistolukkoa, joka siivotaan jos lukon
# ottanut prosessi on kuollut.
lock_acquire() {
	_wait="${1:-0}"
	mkdir -p "$(dirname "$LOCK_FILE")" 2>/dev/null || true

	if have flock; then
		# exec-redirektion epäonnistuminen tappaisi kuoren, joten
		# kirjoitettavuus varmistetaan ensin tavallisella ohjauksella.
		: > "$LOCK_FILE" 2>/dev/null || return 1
		exec 9>"$LOCK_FILE"
		if [ "$_wait" -gt 0 ]; then
			flock -w "$_wait" 9 && return 0
		else
			flock -n 9 && return 0
		fi
		return 1
	fi

	_d="$LOCK_FILE.d"
	_end=$(( $(date +%s) + _wait ))
	while :; do
		if mkdir "$_d" 2>/dev/null; then
			echo $$ > "$_d/pid"
			LOCK_DIR_HELD="$_d"
			return 0
		fi
		_opid="$(cat "$_d/pid" 2>/dev/null)"
		if [ -z "$_opid" ] || ! kill -0 "$_opid" 2>/dev/null; then
			rm -rf "$_d"
			continue
		fi
		[ "$(date +%s)" -lt "$_end" ] || return 1
		sleep 1
	done
}

lock_release() {
	if [ -n "$LOCK_DIR_HELD" ]; then
		rm -rf "$LOCK_DIR_HELD"
		LOCK_DIR_HELD=""
	elif have flock; then
		exec 9>&-
	fi
}

cleanup() { lock_release; rm -f "$JSON_CACHE"; }

# INT/TERM pitää myös poistua: pelkkä siivousansa jättäisi ajon jatkumaan
# (Ctrl-C vapauttaisi lukon kesken binäärinvaihdon, eikä disarmin kill
# tappaisi vahtia lainkaan).
trap 'cleanup' EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# --- levytila -----------------------------------------------------------

# df:n Available on kolmanneksi viimeinen kenttä myös silloin, kun
# laitenimi työntää rivin ensimmäisen sarakkeen leveäksi.
free_kib() { df -k "$1" 2>/dev/null | awk 'END { print $(NF-2) }'; }

file_kib() {
	_sum=0
	for _f in "$@"; do
		[ -f "$_f" ] || continue
		_n="$(wc -c < "$_f" 2>/dev/null || echo 0)"
		_sum=$(( _sum + (_n + 1023) / 1024 ))
	done
	echo "$_sum"
}

need_space() {  # need_space <polku> <KiB> <selite>
	_p="$1"; _need="$2"; _what="$3"
	_free="$(free_kib "$_p")"
	case "$_free" in
		''|*[!0-9]*)
			log "VAROITUS: $_p: vapaata tilaa ei saatu selville, jatketaan"
			return 0 ;;
	esac
	if [ "$_free" -lt "$_need" ]; then
		log "VIRHE: $_p: vapaana ${_free} KiB, $_what vaatii ${_need} KiB"
		return 1
	fi
	return 0
}

# --- JSON ---------------------------------------------------------------

# jsonfilter (libubox) on OpenWrt:ssä vakiona. sed-varapolku on jäljellä
# siltä varalta, että sitä ei ole — se on hauraampi mutta parempi kuin
# ei mitään.
fetch_stable_json() {
	[ -s "$JSON_CACHE" ] && return 0
	# Työhakemisto voi olla asetuksissa osoitettu levylle, jota ei ole
	# luotu. Ilman tätä lataus epäonnistuisi kertomatta miksi.
	if ! mkdir -p "$TMP_DIR" 2>/dev/null || [ ! -w "$TMP_DIR" ]; then
		log "VIRHE: työhakemistoon ei voi kirjoittaa: $TMP_DIR"
		return 1
	fi
	if ! "$WGET" -q -T 30 -O "$JSON_CACHE" "$BASE_URL/?mode=json" 2>/dev/null; then
		rm -f "$JSON_CACHE"
		return 1
	fi
	[ -s "$JSON_CACHE" ] || { rm -f "$JSON_CACHE"; return 1; }
	return 0
}

# json_string <tiedosto> <jsonfilter-lauseke> <kentän nimi sed-varapolulle>
json_string() {
	_f="$1"; _expr="$2"; _key="$3"
	if have jsonfilter; then
		_v="$(jsonfilter -i "$_f" -e "$_expr" 2>/dev/null)"
		if [ -n "$_v" ]; then
			printf '%s\n' "$_v"
			return 0
		fi
	fi
	tr '\n' ' ' < "$_f" \
		| sed -n "s/.*\"$_key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
		| head -n1
}

latest_version() {
	fetch_stable_json || return 1
	json_string "$JSON_CACHE" '@.TarballsVersion' TarballsVersion
}

# Palvelimen tarjoamat tarballit, esim. tailscale_1.102.2_arm64.tgz.
tarball_list() {
	fetch_stable_json || return 1
	if have jsonfilter; then
		_l="$(jsonfilter -i "$JSON_CACHE" -e '@.Tarballs[*]' 2>/dev/null)"
		if [ -n "$_l" ]; then
			printf '%s\n' "$_l"
			return 0
		fi
	fi
	# shellcheck disable=SC2020  # tarkoituksella merkki kerrallaan rivinvaihdoksi
	tr ',{}' '\n\n\n' < "$JSON_CACHE" \
		| sed -n 's/.*"\(tailscale_[^"]*\.tgz\)".*/\1/p'
}

available_arches() {
	tarball_list | sed -n 's/^tailscale_[^_]*_\(.*\)\.tgz$/\1/p' | sort | tr '\n' ' '
}

# 0 = kyseinen versio/arkkitehtuuri on olemassa palvelimella.
tarball_available() {  # tarball_available <versio> <arch>
	tarball_list | grep -qxF "tailscale_$1_$2.tgz"
}

# --- versiot ------------------------------------------------------------

# OpenWrt-paketti raportoi "1.98.3-1 (OpenWrt)" mutta ylävirran
# TarballsVersion on "1.98.3". Vertailu tehdään vain numero-osasta,
# ettei feed-versio näytä ikuisesti eri versiolta kuin ylävirta.
normalize_version() {
	printf '%s\n' "${1:-}" | awk '{print $1}' | sed 's/^v//; s/[-_].*$//'
}

current_version() { tailscale version 2>/dev/null | head -n1; }

# 0 = $1 on aidosti uudempi kuin $2
version_newer() {
	_a="$(normalize_version "$1")"
	_b="$(normalize_version "$2")"
	[ -n "$_a" ] && [ -n "$_b" ] || return 0
	[ "$_a" = "$_b" ] && return 1
	_first="$(printf '%s\n%s\n' "$_a" "$_b" | sort -t. -k1,1n -k2,2n -k3,3n | head -n1)"
	[ "$_first" = "$_b" ]
}

# --- terveystarkistus ---------------------------------------------------

backend_state() {
	if have jsonfilter; then
		_s="$(tailscale status --json 2>/dev/null | jsonfilter -e '@.BackendState' 2>/dev/null)"
		if [ -n "$_s" ]; then
			printf '%s\n' "$_s"
			return 0
		fi
	fi
	tailscale status --json 2>/dev/null | tr '\n' ' ' \
		| sed -n 's/.*"BackendState"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
		| head -n1
}

prefs_routes() {
	if have jsonfilter; then
		_r="$(tailscale debug prefs 2>/dev/null | jsonfilter -e '@.AdvertiseRoutes[*]' 2>/dev/null)"
		if [ -n "$_r" ]; then
			printf '%s\n' "$_r" | sort
			return 0
		fi
	fi
	tailscale debug prefs 2>/dev/null | tr -d ' \n' \
		| sed -n 's/.*"AdvertiseRoutes":\[\([^]]*\)\].*/\1/p' \
		| tr ',' '\n' | tr -d '"' | sed '/^$/d' | sort
}

iface_exists() { [ -e "/sys/class/net/$IFACE" ]; }

# Talteen se, mitä ennen päivitystä oli pystyssä: pelkkä "Running" ei
# riitä subnet-reitittimellä tai exit nodella, jos mainostetut reitit
# katoavat prefseistä.
snapshot_health() {
	if iface_exists; then echo 1 > "$EXPECT_IFACE"; else echo 0 > "$EXPECT_IFACE"; fi
	prefs_routes > "$EXPECT_ROUTES" 2>/dev/null || : > "$EXPECT_ROUTES"
}

routes_ok() {
	[ "$CHECK_ROUTES" = "1" ] || return 0
	[ -s "$EXPECT_ROUTES" ] || return 0
	# Ei diffiä: se ei kuulu OpenWrt:n busyboxin oletusvalikoimaan.
	[ "$(prefs_routes)" = "$(cat "$EXPECT_ROUTES" 2>/dev/null)" ]
}

iface_ok() {
	[ -f "$EXPECT_IFACE" ] || return 0
	[ "$(cat "$EXPECT_IFACE" 2>/dev/null)" = "1" ] || return 0
	iface_exists
}

peer_ok() {
	[ -n "$PEER" ] || return 0
	tailscale ping -c 1 --timeout 5s "$PEER" >/dev/null 2>&1
}

# Odottaa että daemon nousee ja että kaikki tarkistukset menevät läpi.
# 0 = terve.
health_check() {
	_i=0
	_why="daemon ei noussut"
	while [ "$_i" -lt "$HEALTH_WAIT" ]; do
		if [ "$(backend_state)" = "Running" ]; then
			_why=""
			iface_ok  || _why="verkkoliitäntä $IFACE puuttuu"
			if [ -z "$_why" ]; then
				routes_ok || _why="mainostetut reitit eivät vastaa päivitystä edeltävää tilaa"
			fi
			if [ -z "$_why" ]; then
				peer_ok || _why="peer $PEER ei vastaa"
			fi
			[ -z "$_why" ] && return 0
		fi
		sleep 3
		_i=$(( _i + 3 ))
	done
	log "terveystarkistus: $_why"
	return 1
}

# --- binäärit -----------------------------------------------------------

# Feedin asennuksessa tailscale on symlinkki tailscalediin. Symlinkkiä ei
# gzipata: se tallentaisi saman ~30 MB:n binäärin toiseen kertaan ja
# kaksinkertaistaisi sekä varmuuskopion että vaaditun levytilan.
backup_binaries() {
	mkdir -p "$BACKUP_DIR" || return 1

	_link=""
	[ -L "$SBIN_DIR/tailscale" ] && _link="$(readlink "$SBIN_DIR/tailscale")"

	if [ -n "$_link" ]; then
		_raw="$(file_kib "$SBIN_DIR/tailscaled")"
	else
		_raw="$(file_kib "$SBIN_DIR/tailscaled" "$SBIN_DIR/tailscale")"
	fi
	# Go-binäärit pakkautuvat noin 40 prosenttiin; 60 % on varovainen
	# arvio. Lopullinen suoja on gzipin oma virhe, joka tulee ennen kuin
	# mitään on vaihdettu.
	need_space "$BACKUP_DIR" "$(( _raw * 3 / 5 ))" "varmuuskopio" || return 1

	gzip -c "$SBIN_DIR/tailscaled" > "$BACKUP_DIR/tailscaled.gz.new" || return 1
	mv "$BACKUP_DIR/tailscaled.gz.new" "$BACKUP_DIR/tailscaled.gz" || return 1

	rm -f "$BACKUP_DIR/tailscale.link"
	if [ -n "$_link" ]; then
		printf '%s\n' "$_link" > "$BACKUP_DIR/tailscale.link"
		rm -f "$BACKUP_DIR/tailscale.gz"
	else
		gzip -c "$SBIN_DIR/tailscale" > "$BACKUP_DIR/tailscale.gz.new" || return 1
		mv "$BACKUP_DIR/tailscale.gz.new" "$BACKUP_DIR/tailscale.gz" || return 1
	fi

	current_version > "$BACKUP_DIR/version"
	sync
	return 0
}

# Karkea arvio siitä, paljonko uudet binäärit vievät asennuskohteessa.
# Ylävirran tarballissa on kaksi erillistä binääriä siinä missä feedin
# asennuksessa on yksi binääri ja symlinkki, ja ylävirran binäärit ovat
# vielä isompia kuin OpenWrt:n koko-optimoitu käännös: mitattu 1.102.2
# mipsle = tailscaled 38.7 MiB + tailscale 31.7 MiB = 70.4 MiB, kun
# feedin yhdistetty binääri on 29.1 MiB. Kaksinkertainen nykyinen koko
# on siis yhä aliarvio, mutta riittää torjumaan pienen flashin laitteet
# ennen kuin mitään on ladattu; tarkka tarkistus tehdään install_from:issa
# purettujen tiedostojen todellisista koista.
install_floor_kib() { echo "$(( $(file_kib "$SBIN_DIR/tailscaled") * 2 ))"; }

# Tarkistaa että puretut binäärit ovat olemassa ja käynnistyvät tällä
# laitteella. Tehdään ennen kuin palvelua pysäytetään: väärä
# arkkitehtuuri ei silloin katkaise yhteyttä lainkaan.
verify_binaries() {
	_d="$1"
	if [ ! -f "$_d/tailscaled" ] || [ ! -f "$_d/tailscale" ]; then
		log "VIRHE: purettu paketti ei sisällä molempia binäärejä"
		return 1
	fi
	chmod 755 "$_d/tailscaled" "$_d/tailscale" || return 1
	_v="$("$_d/tailscale" version 2>/dev/null | head -n1)"
	if [ -z "$_v" ]; then
		log "VIRHE: uusi tailscale-binääri ei käynnisty tällä laitteella (väärä arkkitehtuuri?)"
		return 1
	fi
	log "uusi binääri ajettavissa: $_v"
	return 0
}

# Feedin paketti asentaa /usr/sbin/tailscalen symlinkkinä tailscalediin;
# ylävirran tarballissa ne ovat kaksi erillistä tiedostoa, joten symlink
# korvataan mv:llä oikealla binäärillä.
install_from() {
	_dir="$1"
	_need="$(file_kib "$_dir/tailscaled" "$_dir/tailscale")"
	need_space "$SBIN_DIR" "$_need" "binäärien vaihto" || return 1
	"$INIT_SCRIPT" stop
	sleep 1
	cp "$_dir/tailscaled" "$SBIN_DIR/tailscaled.new" || return 1
	cp "$_dir/tailscale"  "$SBIN_DIR/tailscale.new"  || return 1
	chmod 755 "$SBIN_DIR/tailscaled.new" "$SBIN_DIR/tailscale.new"
	mv "$SBIN_DIR/tailscaled.new" "$SBIN_DIR/tailscaled" || return 1
	mv "$SBIN_DIR/tailscale.new"  "$SBIN_DIR/tailscale"  || return 1
	sync
	"$INIT_SCRIPT" start
	return 0
}

do_rollback() {
	if [ ! -f "$BACKUP_DIR/tailscaled.gz" ]; then
		log "VIRHE: varmuuskopiota ei ole, rollback ei onnistu"
		return 1
	fi
	if [ ! -f "$BACKUP_DIR/tailscale.gz" ] && [ ! -f "$BACKUP_DIR/tailscale.link" ]; then
		log "VIRHE: varmuuskopio on vaillinainen, rollback ei onnistu"
		return 1
	fi
	_old="$(cat "$BACKUP_DIR/version" 2>/dev/null)"
	log "palautetaan versio: $_old"
	"$INIT_SCRIPT" stop
	sleep 1
	gunzip -c "$BACKUP_DIR/tailscaled.gz" > "$SBIN_DIR/tailscaled.new" || return 1
	chmod 755 "$SBIN_DIR/tailscaled.new"
	rm -f "$SBIN_DIR/tailscale.new"
	if [ -f "$BACKUP_DIR/tailscale.link" ]; then
		# palautetaan feedin symlink-asettelu sellaisenaan
		ln -s "$(cat "$BACKUP_DIR/tailscale.link")" "$SBIN_DIR/tailscale.new" || return 1
	else
		gunzip -c "$BACKUP_DIR/tailscale.gz" > "$SBIN_DIR/tailscale.new" || return 1
		chmod 755 "$SBIN_DIR/tailscale.new"
	fi
	mv "$SBIN_DIR/tailscaled.new" "$SBIN_DIR/tailscaled" || return 1
	mv "$SBIN_DIR/tailscale.new"  "$SBIN_DIR/tailscale"  || return 1
	sync
	"$INIT_SCRIPT" start
	sleep 5
	log "rollback valmis, nyt: $(current_version)"
	return 0
}

# --- vahti --------------------------------------------------------------

# Odottava päivitys on kesken myös silloin, kun vahtia ei ehditty
# virittää: PENDING_FILE kirjoitetaan ennen binäärinvaihtoa, DEADLINE_FILE
# vasta terveystarkistuksen jälkeen.
pending_active() { [ -f "$DEADLINE_FILE" ] || [ -f "$PENDING_FILE" ]; }

# PID-tiedosto jää levylle boottauksen yli, mutta prosessi ei. Pelkkä
# kill -0 osuisi uudelleenkäytettyyn PID:iin, joten varmistetaan /procista
# että kyseessä on tämä skripti.
watchdog_alive() {
	[ -f "$WATCHDOG_PID" ] || return 1
	_wp="$(cat "$WATCHDOG_PID" 2>/dev/null)"
	case "$_wp" in
		''|*[!0-9]*) return 1 ;;
	esac
	kill -0 "$_wp" 2>/dev/null || return 1
	[ -r "/proc/$_wp/cmdline" ] || return 1
	tr '\0' ' ' < "/proc/$_wp/cmdline" 2>/dev/null | grep -q ts-update
}

disarm() {
	if watchdog_alive; then
		kill "$(cat "$WATCHDOG_PID" 2>/dev/null)" 2>/dev/null
	fi
	rm -f "$WATCHDOG_PID" "$DEADLINE_FILE" "$UPTIME_FILE" "$PENDING_FILE"
	sync
}

# Vahti irrotetaan istunnosta, jotta se elää ssh-yhteyden katkettua.
# 9>&- sulkee periytyvän lukkokahvan: muuten lapsi pitäisi lukkoa
# koko vahvistusikkunan ajan. log() kirjoittaa lokitiedostoon jo itse,
# joten vain odottamaton stderr ohjataan erilliseen tiedostoon.
spawn_watchdog() {
	_secs="$1"
	if have setsid; then
		TIMEOUT="$_secs" ARCH="$ARCH" PEER="$PEER" IFACE="$IFACE" \
		CHECK_ROUTES="$CHECK_ROUTES" HEALTH_WAIT="$HEALTH_WAIT" \
			setsid "$0" _watchdog >/dev/null 2>>"$LOG.stderr" < /dev/null 9>&- &
	else
		TIMEOUT="$_secs" ARCH="$ARCH" PEER="$PEER" IFACE="$IFACE" \
		CHECK_ROUTES="$CHECK_ROUTES" HEALTH_WAIT="$HEALTH_WAIT" \
			nohup "$0" _watchdog >/dev/null 2>>"$LOG.stderr" < /dev/null 9>&- &
	fi
	echo $! > "$WATCHDOG_PID"
	sync
}

# Sekunteja käynnistyksestä. Monotoninen: ntp:n askel ei siirrä tätä.
uptime_now() {
	[ -r /proc/uptime ] || return 1
	read -r _u _rest < /proc/uptime || return 1
	_u="${_u%%.*}"
	case "$_u" in
		''|*[!0-9]*) return 1 ;;
	esac
	echo "$_u"
}

# Määräaika kirjataan kahdesti: monotonisena käynnistyksen jälkeisenä
# hetkenä ja seinäkellon aikaleimana. Ensimmäinen kestää kellon hypyn,
# jälkimmäinen kestää uudelleenkäynnistyksen.
write_deadlines() {
	_secs="$1"
	echo "$(( $(date +%s) + _secs ))" > "$DEADLINE_FILE"
	rm -f "$UPTIME_FILE"
	if _up="$(uptime_now)"; then
		echo "$(( _up + _secs ))" > "$UPTIME_FILE"
	fi
	sync
}

arm_watchdog() {
	_secs="${1:-$TIMEOUT}"
	write_deadlines "$_secs"
	spawn_watchdog "$_secs"
}

# Ilman monotonista laskuria tunnin ntp-hyppy eteenpäin päättäisi
# vahvistusikkunan kesken kaiken ja palauttaisi toimivan päivityksen.
# Havaittu oikealla laitteella, jossa ei ole RTC:tä.
deadline_left() {
	if _up="$(uptime_now)" && [ -f "$UPTIME_FILE" ]; then
		_ud="$(cat "$UPTIME_FILE" 2>/dev/null)"
		case "$_ud" in
			''|*[!0-9]*) _ud="" ;;
		esac
		if [ -n "$_ud" ]; then
			_left=$(( _ud - _up ))
			# Jäljellä ei voi olla enempää kuin koko ikkuna. Jos on,
			# tiedosto on edelliseltä boottikerralta ja uptime nollautui.
			if [ "$_left" -le "$TIMEOUT" ]; then
				echo "$_left"
				return 0
			fi
		fi
	fi
	_dl="$(cat "$DEADLINE_FILE" 2>/dev/null)"
	case "$_dl" in
		''|*[!0-9]*) echo 0; return 1 ;;
	esac
	echo $(( _dl - $(date +%s) ))
}

# --- komennot -----------------------------------------------------------

cmd_check() {
	echo "arkkitehtuuri: ${ARCH:-TUNTEMATON}"
	echo "nykyinen:      $(current_version)"
	_new="$(latest_version)"
	if [ -n "$_new" ]; then
		echo "uusin:         $_new"
	else
		echo "uusin:         EI SAATU — verkko tai $TMP_DIR? ks. $LOG"
	fi
	if [ -n "$_new" ] && [ -n "$ARCH" ]; then
		if tarball_available "$_new" "$ARCH"; then
			echo "paketti:       tailscale_${_new}_${ARCH}.tgz"
		else
			echo "paketti:       EI LÖYDY palvelimelta"
			echo "saatavilla:    $(available_arches)"
		fi
	fi
	if [ -n "$_new" ] && ! version_newer "$_new" "$(current_version)"; then
		echo "tila:          ajan tasalla"
	fi
	_floor="$(install_floor_kib)"
	_free="$(free_kib "$SBIN_DIR")"
	case "$_free" in
		''|*[!0-9]*) ;;
		*)
			echo "levytila:      $SBIN_DIR vapaana $(( _free / 1024 )) MB, tarve vähintään $(( _floor / 1024 )) MB"
			if [ "$_free" -lt "$_floor" ]; then
				echo "               EI RIITÄ — ks. README, pienen flashin laitteet"
			fi
			;;
	esac
}

cmd_run() {
	_dry=0
	case "${1:-}" in
		--dry-run|-n) _dry=1 ;;
		'') ;;
		*) echo "tuntematon valitsin: $1"; exit 1 ;;
	esac

	if ! lock_acquire 0; then
		echo "Toinen ts-update-ajo on kesken."
		exit 1
	fi

	if [ -z "$ARCH" ]; then
		log "VIRHE: arkkitehtuuria ei tunnistettu, anna se käsin: ARCH=... $0 run"
		exit 1
	fi
	if pending_active; then
		echo "Edellinen päivitys odottaa yhä vahvistusta. Aja ensin: $0 confirm"
		exit 1
	fi

	cur="$(current_version)"
	new="$(latest_version)"
	if [ -z "$new" ]; then
		log "VIRHE: uusinta versiota ei saatu selville"
		exit 1
	fi
	if ! version_newer "$new" "$cur"; then
		echo "Jo uusin: $cur (ylävirta: $new)"
		exit 0
	fi
	if ! tarball_available "$new" "$ARCH"; then
		log "VIRHE: palvelimella ei ole pakettia tailscale_${new}_${ARCH}.tgz"
		log "saatavilla olevat arkkitehtuurit: $(available_arches)"
		log "aseta oikea käsin: ARCH=... $0 run"
		exit 1
	fi

	if [ "$_dry" = 1 ]; then
		log "KUIVAHARJOITUS: $cur -> $new ($ARCH), binäärejä ei vaihdeta"
	else
		log "päivitetään $cur -> $new ($ARCH)"
	fi

	tgz="$TMP_DIR/tailscale_${new}_${ARCH}.tgz"
	dir="$TMP_DIR/tailscale_${new}_${ARCH}"
	sha="$TMP_DIR/ts-update.sha"
	rm -rf "$tgz" "$dir" "$sha"

	# Asennuskohde ensin: jos binäärit eivät sinne mahdu, koko lataus on
	# turha. Pienen flashin laitteella tämä pysäyttää ajon sekunneissa.
	need_space "$SBIN_DIR" "$(install_floor_kib)" "binäärien vaihto" || {
		log "asennuskohteessa ei ole tilaa uusille binääreille — ei ladata mitään"
		exit 1
	}
	need_space "$TMP_DIR" "$NEED_TMP_KIB" "lataus" || exit 1

	"$WGET" -q -T 60 "$BASE_URL/tailscale_${new}_${ARCH}.tgz" -O "$tgz" || {
		log "VIRHE: lataus epäonnistui"; rm -f "$tgz"; exit 1; }
	"$WGET" -q -T 60 "$BASE_URL/tailscale_${new}_${ARCH}.tgz.sha256" -O "$sha" || {
		log "VIRHE: tarkistussummaa ei saatu"; rm -f "$tgz" "$sha"; exit 1; }

	sum="$(awk '{print $1; exit}' "$sha")"
	if [ -z "$sum" ]; then
		log "VIRHE: tarkistussumma on tyhjä"
		rm -f "$tgz" "$sha"
		exit 1
	fi
	if ! (cd "$TMP_DIR" && echo "$sum  $(basename "$tgz")" | sha256sum -c >/dev/null 2>&1); then
		log "VIRHE: tarkistussumma ei täsmää"
		rm -f "$tgz" "$sha"
		exit 1
	fi
	log "tarkistussumma ok"

	# Nyt tarballin koko tiedetään. Mitattu suhde (1.102.2 mipsle): 32.3
	# MiB pakattuna, 70.4 MiB purettuna, ja tarballi jää levylle purun
	# ajaksi — yhteensä 3.2-kertaisesti. 3.5 antaa pienen marginaalin.
	need_space "$TMP_DIR" "$(( $(file_kib "$tgz") * 7 / 2 ))" "purku" || {
		rm -f "$tgz" "$sha"
		exit 1
	}

	tar xzf "$tgz" -C "$TMP_DIR" || {
		log "VIRHE: purku epäonnistui"; rm -rf "$tgz" "$sha" "$dir"; exit 1; }

	verify_binaries "$dir" || { rm -rf "$tgz" "$sha" "$dir"; exit 1; }

	if [ "$_dry" = 1 ]; then
		rm -rf "$dir" "$tgz" "$sha"
		cat <<EOF

  Kuivaharjoitus valmis: $cur -> $new ($ARCH)
  Lataus, tarkistussumma ja binäärin ajettavuus ok.
  Mitään ei pysäytetty eikä vaihdettu. Oikea päivitys: $0 run

EOF
		exit 0
	fi

	snapshot_health

	backup_binaries || { log "VIRHE: varmuuskopiointi epäonnistui, ei jatketa"; exit 1; }
	log "varmuuskopio: $BACKUP_DIR ($cur)"

	printf '%s\n' "$cur -> $new ($ARCH)" > "$PENDING_FILE"

	install_from "$dir" || {
		log "VIRHE: asennus epäonnistui, palautetaan"
		do_rollback
		rm -f "$PENDING_FILE"
		exit 1
	}

	rm -rf "$dir" "$tgz" "$sha"

	if ! health_check; then
		log "terveystarkistus epäonnistui — palautetaan heti"
		do_rollback
		rm -f "$PENDING_FILE"
		exit 1
	fi

	log "asennettu ja daemon pystyssä: $(current_version)"
	arm_watchdog "$TIMEOUT"

	cat <<EOF

  Päivitys tehty: $cur -> $new
  Rollback tapahtuu automaattisesti $(( TIMEOUT / 60 )) min $(( TIMEOUT % 60 )) s kuluttua,
  ellei tätä ennen ajeta:

      ts-update confirm

  Testaa yhteys ULKOPUOLELTA (toiselta tailnet-laitteelta) ennen vahvistusta.

EOF
}

cmd_confirm() {
	if ! pending_active; then
		echo "Mitään ei odota vahvistusta."
		exit 0
	fi
	# Lukko on vahdilla rollbackin ajan: odotetaan sen verran, ettei
	# vahvistusta raportoida onnistuneeksi kesken palautuksen.
	if ! lock_acquire 60; then
		log "VIRHE: lukkoa ei saatu — rollback saattaa olla käynnissä"
		exit 1
	fi
	if ! pending_active; then
		log "rollback ehti tapahtua ennen vahvistusta, nyt: $(current_version)"
		exit 1
	fi
	disarm
	log "vahvistettu, rollback peruttu: $(current_version)"
}

cmd_rollback() {
	if ! lock_acquire 60; then
		log "VIRHE: lukkoa ei saatu, toinen ajo on kesken"
		exit 1
	fi
	disarm
	do_rollback
}

cmd_status() {
	echo "arkkitehtuuri: ${ARCH:-TUNTEMATON}"
	echo "versio:        $(current_version)"
	echo "varmuuskopio:  $(cat "$BACKUP_DIR/version" 2>/dev/null || echo 'ei ole')"
	if pending_active; then
		echo "odottaa:       $(cat "$PENDING_FILE" 2>/dev/null || echo 'päivitys')"
		if [ ! -f "$DEADLINE_FILE" ]; then
			echo "KESKEN: päivitys jäi ilman vahtia — aja $0 boot-check tai $0 rollback"
		else
			_left="$(deadline_left)"
			if [ "$_left" -gt 0 ]; then
				echo "ODOTTAA VAHVISTUSTA: rollback ${_left} s kuluttua"
			else
				echo "ODOTTAA VAHVISTUSTA: vahvistusaika umpeutunut"
			fi
			if watchdog_alive; then
				echo "vahti:         käynnissä (pid $(cat "$WATCHDOG_PID"))"
			else
				echo "vahti:         EI KÄYNNISSÄ — aja $0 boot-check tai $0 rollback"
			fi
		fi
	else
		echo "ei odottavaa päivitystä"
	fi
	tailscale status 2>/dev/null | head -2
}

# Vahti seuraa määräaikaa tiedostosta, ei pelkkää sleepiä: confirm
# poistaa tiedoston, jolloin vahti lopettaa itsestään.
cmd_watchdog() {
	while :; do
		pending_active || exit 0
		_left="$(deadline_left)" || exit 0
		[ "$_left" -le 0 ] && break
		if [ "$_left" -gt 5 ]; then sleep 5; else sleep "$_left"; fi
	done
	log "vahvistusta ei tullut määräaikaan mennessä — automaattinen rollback"
	if ! lock_acquire 120; then
		log "VAROITUS: lukkoa ei saatu 120 s:ssa, tehdään rollback silti"
	fi
	# Vahvistus on voinut tulla juuri lukkoa odotellessa.
	if ! pending_active; then
		log "vahvistus ehti tulla — ei palauteta"
		exit 0
	fi
	do_rollback
	rm -f "$WATCHDOG_PID" "$DEADLINE_FILE" "$UPTIME_FILE" "$PENDING_FILE"
	sync
}

# Ajetaan boottauksen jälkeen (/etc/init.d/ts-update-bootcheck). Ilman
# tätä RAMissa asunut vahti kuolisi uudelleenkäynnistyksessä ja
# vahvistamaton päivitys jäisi pysyvästi voimaan.
cmd_boot_check() {
	pending_active || exit 0
	if ! lock_acquire 120; then
		log "boot-check: lukkoa ei saatu, ohitetaan"
		exit 1
	fi
	# Ei määräaikaa mutta odottava päivitys: boottaus osui binäärinvaihdon
	# ja vahdin virityksen väliin, eikä uutta versiota ehditty todeta
	# terveeksi. Vahvistamaton versio ei jää voimaan.
	if [ ! -f "$DEADLINE_FILE" ]; then
		log "boot-check: päivitys keskeytyi ennen vahdin viritystä — palautetaan"
		disarm
		do_rollback
		exit 0
	fi

	_left="$(deadline_left)"
	# Kello voi hypätä ntp-synkassa; määräaika ei saa venyä alkuperäistä
	# vahvistusaikaa pidemmäksi.
	if [ "$_left" -gt "$TIMEOUT" ]; then
		_left="$TIMEOUT"
	fi
	log "boot-check: vahvistamaton päivitys kesken ($(cat "$PENDING_FILE" 2>/dev/null))"

	if ! health_check; then
		log "boot-check: terveystarkistus ei mennyt läpi — palautetaan"
		disarm
		do_rollback
		exit 0
	fi
	if [ "$_left" -le 0 ]; then
		log "boot-check: vahvistusaika ehti umpeutua — palautetaan"
		disarm
		do_rollback
		exit 0
	fi
	log "boot-check: viritetään vahti uudelleen ${_left} s:ksi"
	# Uptime nollautui boottauksessa, joten molemmat määräajat
	# kirjoitetaan uusiksi jäljellä olevan ajan mukaan.
	write_deadlines "$_left"
	spawn_watchdog "$_left"
}

case "${1:-}" in
	check)      cmd_check ;;
	run)        shift; cmd_run "${1:-}" ;;
	confirm)    cmd_confirm ;;
	rollback)   cmd_rollback ;;
	status)     cmd_status ;;
	boot-check) cmd_boot_check ;;
	_watchdog)  cmd_watchdog ;;
	*)
		usage
		exit 1
		;;
esac


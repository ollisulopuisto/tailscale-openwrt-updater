# Example: /etc/default/ts-update
#
# Device-specific configuration settings. Environment variables take precedence over
# this file, so any single execution can be overridden: TIMEOUT=900 ts-update run

# Binary architecture. If empty, automatically detected and verified against
# the pkgs.tailscale.com package list.
#ARCH=arm64

# Confirmation window in seconds before automatic rollback triggers.
TIMEOUT=300

# Tailnet IP or hostname to ping during health test. Recommended to choose a
# device that is always online and through which traffic to this router flows.
#PEER=100.74.52.79

# Network interface whose existence is checked after an update.
#IFACE=tailscale0

# 1 = verify advertised routes (subnet router / exit node) remain unchanged after update.
CHECK_ROUTES=1

# Seconds to wait for daemon startup before considering update failed.
HEALTH_WAIT=90

# Download command if device wget is in a non-standard location.
#WGET=uclient-fetch

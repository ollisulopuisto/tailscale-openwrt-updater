#!/bin/sh /etc/rc.common
# Install as /etc/init.d/ts-update-bootcheck and enable:
#   /etc/init.d/ts-update-bootcheck enable
#
# An unconfirmed update lives in the /root/ts-update directory, but
# the watchdog process does not survive a reboot. This restarts it
# for the remaining window duration — or performs an automatic rollback
# if the deadline expired or the daemon failed to start.

# shellcheck disable=SC2034  # rc.common reads these
START=99
# shellcheck disable=SC2034
STOP=99

start() {
	[ -x /usr/sbin/ts-update ] || return 0
	# Background execution: health check waits for daemon up to 90
	# seconds, and reboot should not be blocked during that time.
	# If nothing is pending confirmation, boot-check exits immediately.
	/usr/sbin/ts-update boot-check >/dev/null 2>&1 &
}

stop() {
	return 0
}

# ts-update-eof
